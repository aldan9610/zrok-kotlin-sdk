<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="zrok SDK para Android — ejemplo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sin entorno habilitado" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Habilitar entorno con tu token de cuenta"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/account_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Account token (zrok console)"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habilitar entorno" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Compartir un servicio TCP local (tcpTunnel privado)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/target_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host local (p. ej. 127.0.0.1)"
            android:inputType="text" />

        <EditText
            android:id="@+id/target_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto local (p. ej. 8080)"
            android:inputType="number" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear share y abrir túnel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Acceder a un share privado (de otro dispositivo)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/share_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token del share privado"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear access y puente local" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. Compartir tu IP como proxy SOCKS5 (navega desde otro dispositivo con esta IP)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/socks_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario SOCKS (opcional, recomendado en público)"
            android:inputType="text" />

        <EditText
            android:id="@+id/socks_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña SOCKS (opcional)"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_socks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear share SOCKS y compartir IP" />

        <TextView
            android:id="@+id/socks_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/access_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Detener túnel" />

    </LinearLayout>
</ScrollView>
